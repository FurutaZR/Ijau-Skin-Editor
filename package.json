{
  "name": "ijaus-skin-editor",
  "version": "1.5.0",
  "description": "Ijau skin editor",
  "author": "Ijau",
  "main": "main.js",
  "scripts": {
    "postinstall": "node setup.js",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "three": "0.128.0",
    "@fontsource/vt323": "^5.0.0"
  },
  "build": {
    "appId": "com.ijau.skineditor",
    "productName": "Ijaus Skin Editor",
    "files": [
      "index.html",
      "main.js",
      "icon.ico",
      "lib/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}